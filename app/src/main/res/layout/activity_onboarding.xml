<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Step indicator -->
    <LinearLayout
        android:id="@+id/onb_stepper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" />

    <ViewFlipper
        android:id="@+id/onb_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <!-- Step 0: Welcome + language -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_welcome_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onb_welcome_body"
                    android:textAppearance="?attr/textAppearanceBody1" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/app_language"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/onb_language_help"
                    android:textAppearance="?attr/textAppearanceCaption" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onb_language_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:icon="@drawable/ic_translate" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 1: Safety -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_safety_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/onb_safety_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBody2" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/onb_safety_accept"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_safety_accept" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: Connection (USB / WiFi) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_connection_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onb_connection_help"
                    android:textAppearance="?attr/textAppearanceBody2" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/onb_conn_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_conn_usb"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_kind_usb" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_conn_wifi"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_kind_wifi" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView
                    android:id="@+id/onb_conn_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceCaption" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 3: Display auto-scan -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_display_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/onb_display_detected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBody2" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_display_size_label"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/onb_size_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_size_phone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_size_phone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_size_small"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_size_small" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_size_standard"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_size_standard" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_size_large"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_size_large" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_display_orientation_label"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/onb_orient_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_orient_land"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_orientation_landscape" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_orient_port"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_orientation_portrait" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onb_display_run"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_display_apply" />
                <TextView
                    android:id="@+id/onb_display_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:textAppearance="?attr/textAppearanceBody2" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 4: Appearance -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_appearance_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_appearance_theme_label"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onb_theme_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:icon="@android:drawable/ic_menu_manage" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/onb_appearance_night_label"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onb_night_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:icon="@android:drawable/ic_menu_manage" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onb_appearance_more"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_more_appearance" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 5: Automation -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_automation_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onb_automation_help"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_connect_last_session"
                        android:textAppearance="?attr/textAppearanceBody1" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/onb_autoconnect_last_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_connect_single_usb"
                        android:textAppearance="?attr/textAppearanceBody1" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/onb_autoconnect_single_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_autoconnect_more"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_connect_settings" />
                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_autostart_more"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_start_settings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/onb_automation_oem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_setting_single"
                    android:text="@string/auto_start_oem_warning"
                    android:textAppearance="?attr/textAppearanceCaption" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 6: GPS / Location -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_gps_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onb_gps_help"
                    android:textAppearance="?attr/textAppearanceBody2" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/onb_gps_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_gps_device"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/onb_gps_this_device" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/onb_gps_phone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/onb_gps_phone" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </ScrollView>

        <!-- Step 7: Ready -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_ready_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/onb_ready_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBody1" />
            </LinearLayout>
        </ScrollView>

    </ViewFlipper>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <!-- Secondary action on its own row so it never crowds Back/Next -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onb_skip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/onb_do_it_later" />

        <!-- Primary navigation: compact back arrow + Next/Finish -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_back"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/back"
                app:icon="@drawable/ic_arrow_back" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/onb_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onb_next" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
