<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.andrerinas.headunitrevived.view.DpiPreviewView
        android:id="@+id/dpi_preview"
        android:layout_width="match_parent"
        android:layout_height="160dp" />

    <TextView
        android:id="@+id/dpi_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceSubtitle1" />

    <com.google.android.material.slider.Slider
        android:id="@+id/dpi_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:valueFrom="110"
        android:valueTo="240"
        android:stepSize="2"
        android:value="160" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/dpi_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_small"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/onb_dpi_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_medium"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/onb_dpi_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dpi_tab_large"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/onb_dpi_large" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</merge>
